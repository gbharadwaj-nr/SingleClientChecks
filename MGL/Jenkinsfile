pipeline {
    agent any

    triggers {
        cron('H 6 * * *')
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        PYTHONUNBUFFERED = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                // checkout scm places the whole repo at the workspace root, so paths
                // are relative to the repo root here, not to MGL/.
                bat 'pip install -r requirements.txt'
            }
        }

        stage('Verify AWS Credentials') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-master-account']
                ]) {
                    bat '''
                    @echo off
                    aws sts get-caller-identity >nul 2>&1
                    if %ERRORLEVEL%==0 (
                        echo AWS Credentials Verified Successfully
                    ) else (
                        echo ERROR : AWS Credentials Verification Failed
                        exit /b 1
                    )
                    '''
                }
            }
        }

        stage('Run health checks') {
            steps {
                // Injects AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN for the
                // master account (bootstrap.py assumes the client role from there), TEAMS_WEBHOOK
                // so main.py can post the executive summary to Teams, and (once available) the
                // MGL_DB_* credentials for the Database Validation check - uncomment and set a
                // real credential ID below when DB access is configured.
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-master-account'],
                    string(credentialsId: 'teams-webhook', variable: 'TEAMS_WEBHOOK')
                    // , usernamePassword(credentialsId: 'mgl-db-credentials', usernameVariable: 'MGL_DB_USER', passwordVariable: 'MGL_DB_PASSWORD')
                ]) {
                    dir('MGL') {
                        bat 'python -u main.py'
                    }
                }
            }
        }

        stage('Publish report') {
            steps {
                archiveArtifacts artifacts: 'MGL/output/*.html', fingerprint: true
                publishHTML(target: [
                    reportDir: 'MGL/output',
                    reportFiles: 'report.html',
                    reportName: 'MGL AWS Health Check'
                ])
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
