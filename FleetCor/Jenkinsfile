pipeline {
    agent any

    triggers {
        cron('H 6 * * *')
    }

    options {
        timestamps()
    }

    environment {
        AWS_PROFILE = 'fleetcor'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                // checkout scm places the whole repo at the workspace root, so paths
                // are relative to the repo root here, not to FleetCor/.
                bat 'pip install -r requirements.txt'
            }
        }

        stage('Run health checks') {
            steps {
                dir('FleetCor') {
                    bat 'python main.py'
                }
            }
        }

        stage('Publish report') {
            steps {
                archiveArtifacts artifacts: 'FleetCor/output/*.html', fingerprint: true
                publishHTML(target: [
                    reportDir: 'FleetCor/output',
                    reportFiles: 'report.html',
                    reportName: 'FleetCor AWS Health Check'
                ])
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
