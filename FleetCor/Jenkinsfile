pipeline {
    agent any

    triggers {
        cron('H 6 * * *')
    }

    options {
        timestamps()
    }

    environment {
        AWS_PROFILE = 'fleetcor'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                bat 'pip install -r ../requirements.txt'
            }
        }

        stage('Run health checks') {
            steps {
                bat 'python main.py'
            }
        }

        stage('Publish report') {
            steps {
                archiveArtifacts artifacts: 'output/*.html', fingerprint: true
                publishHTML(target: [
                    reportDir: 'output',
                    reportFiles: 'report.html',
                    reportName: 'FleetCor AWS Health Check'
                ])
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
